# ── Scraper tuning ──────────────────────────────────────────────
GRANTSCOUT_REQUEST_TIMEOUT=30
GRANTSCOUT_MAX_RETRIES=3
GRANTSCOUT_RATE_LIMIT_DELAY=1.0

# ── SMTP email alerts ──────────────────────────────────────────
GRANTSCOUT_SMTP_HOST=smtp.gmail.com
GRANTSCOUT_SMTP_PORT=587
GRANTSCOUT_SMTP_USER=
GRANTSCOUT_SMTP_PASSWORD=
GRANTSCOUT_ALERT_FROM=
GRANTSCOUT_ALERT_TO=

# ── Webhook alerts (Slack / Discord) ──────────────────────────
GRANTSCOUT_WEBHOOK_URL=

# ── Output ─────────────────────────────────────────────────────
GRANTSCOUT_OUTPUT_DIR=./output
GRANTSCOUT_LOG_FILE=./grantscout.log
